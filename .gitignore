# Python caches and test output.
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Local Python environment.
/.venv/

# Local simulation regression tests.
/simulation/tests/

# Local simulation datasets, except measured retina recordings.
/simulation/data/*
!/simulation/data/measured_retina_events/

# Regenerated optimization outputs.
/results/

